<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" fill="#00ff41">
  <!-- Hat brim -->
  <ellipse cx="100" cy="85" rx="70" ry="12" fill="#00ff41"/>
  <!-- Hat crown -->
  <rect x="50" y="30" width="100" height="55" rx="8" fill="#00ff41"/>
  <rect x="55" y="35" width="90" height="50" rx="6" fill="#0a1f0a"/>
  <rect x="50" y="75" width="100" height="10" fill="#00ff41"/>
  <!-- Head -->
  <ellipse cx="100" cy="120" rx="45" ry="40" fill="#00ff41"/>
  <ellipse cx="100" cy="120" rx="42" ry="37" fill="#0a1f0a"/>
  <!-- Glasses -->
  <circle cx="82" cy="115" r="14" fill="none" stroke="#00ff41" stroke-width="3"/>
  <circle cx="118" cy="115" r="14" fill="none" stroke="#00ff41" stroke-width="3"/>
  <line x1="96" y1="115" x2="104" y2="115" stroke="#00ff41" stroke-width="3"/>
  <line x1="68" y1="115" x2="55" y2="112" stroke="#00ff41" stroke-width="3"/>
  <line x1="132" y1="115" x2="145" y2="112" stroke="#00ff41" stroke-width="3"/>
  <!-- Goatee -->
  <path d="M92 140 L100 155 L108 140" fill="none" stroke="#00ff41" stroke-width="2.5"/>
  <!-- Mustache -->
  <path d="M85 132 Q93 128 100 132 Q107 128 115 132" fill="none" stroke="#00ff41" stroke-width="2.5"/>
</svg>
