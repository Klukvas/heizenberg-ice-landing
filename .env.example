# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
SECURE_SSL_REDIRECT=0
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Database
DB_NAME=heizenberg_ice
DB_USER=heizenberg
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Monobank Acquiring (ФОП)
# Токен з https://web.monobank.ua → Підприємець → API для еквайрингу
MONOBANK_TOKEN=your-monobank-merchant-token

# Django superuser (used by deploy.sh on first run)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@heizenberg.ice
DJANGO_SUPERUSER_PASSWORD=change-me
